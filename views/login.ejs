<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Meli Auto</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-gray-50 min-h-screen flex items-center justify-center"><main class="bg-white border rounded-2xl shadow-sm p-8 w-full max-w-sm"><h1 class="text-2xl font-bold">Meli Auto</h1><p class="text-gray-500 mt-2 mb-6">Acesso privado</p><% if(error){%><div class="bg-red-50 text-red-700 p-3 rounded-lg mb-4"><%=error%></div><%}%><form method="post" action="/private-login"><label class="text-sm font-medium">Senha</label><input autofocus name="password" type="password" required class="mt-2 w-full border rounded-lg px-3 py-2"><button class="mt-4 w-full bg-black text-white rounded-lg py-2.5 font-medium">Entrar</button></form></main></body></html>
